# Copy to .env.local and fill in. For local development, run
# `supabase start` (see PLANNING.md/CLAUDE.md) and copy the values it
# prints — they match this shape exactly.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

DATABASE_URL=

# Protects /api/cron/purge (see vercel.json). Required in production —
# without it the endpoint has no auth check at all. Leave unset locally;
# that's what lets you call it directly for testing.
CRON_SECRET=
