# Copy to .env.local and fill in. For local development, run
# `supabase start` (see PLANNING.md/CLAUDE.md) and copy the values it
# prints — they match this shape exactly.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

DATABASE_URL=

# Protects /api/cron/purge (see vercel.json). Required in production —
# without it the endpoint has no auth check at all. Leave unset locally;
# that's what lets you call it directly for testing.
CRON_SECRET=

# Stripe (test mode for local dev — see dashboard.stripe.com/test/apikeys).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The $5/mo paid-plan Price id (Products catalog in the Stripe dashboard).
STRIPE_PRICE_ID=
# Signs incoming webhook payloads. For local dev this can be any string —
# tests/integration/stripe-webhook.test.ts signs its own synthetic events
# with whatever's here, it doesn't need to match anything real. Production
# uses the real value from the dashboard's webhook endpoint config.
STRIPE_WEBHOOK_SECRET=
